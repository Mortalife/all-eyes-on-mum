{
  "name": "all-eyes-on-mum",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & node --env-file .env --watch src/index.ts",
    "dev:server": "node --env-file .env --watch src/index.ts",
    "dev:css": "vite build --watch",
    "check:prettier": "prettier --write .",
    "check:types": "tsc --noEmit",
    "check": "pnpm run check:prettier && pnpm run check:types",
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.18.0",
    "@sidequest/sqlite-backend": "^1.17.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.17",
    "sidequest": "^1.17.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "daisyui": "^5.7.50",
    "esbuild": "^0.28.2",
    "glob": "^14.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
