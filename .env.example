# Server
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
# Required in production; match Cloudflare's X-Origin-Secret request header.
# Leave empty for local development. Generate with: openssl rand -hex 32
ORIGIN_SECRET=

# Database
DATABASE_PATH=./data/

# Admin email used by the local setup command (public registration is disabled)
ADMIN_EMAIL=admin@example.com

# Phone push notifications (optional) - generate with: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
